rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCategory(cat) {
      return cat in [
        'Food',
        'Chai & Snacks',
        'Transport',
        'Grocery',
        'Shopping',
        'Subscriptions',
        'Entertainment',
        'Bills',
        'Bills & Rent',
        'Salary',
        'Freelance',
        'Cashback',
        'Refund',
        'Investment',
        'Other'
      ];
    }

    function isValidPaymentMode(mode) {
      return mode in ['UPI', 'Cash', 'Card'];
    }

    function isValidThemeId(themeId) {
      return themeId in ['stark', 'mark85', 'stealth'];
    }

    function isValidGuardTone(tone) {
      return tone in ['roast', 'hinglish', 'disciplined'];
    }

    function isValidProTier(tier) {
      return tier in ['free', 'gold', 'platinum', 'monthly', 'annual', 'sovereign'];
    }

    function isValidOptionalProFields(data) {
      return (!('isPro' in data) || data.isPro is bool)
        && (!('proTier' in data) || (data.proTier is string && isValidProTier(data.proTier)))
        && (!('proExpiryMillis' in data) || (data.proExpiryMillis is int && data.proExpiryMillis >= 0))
        && (!('proExpiresAtMillis' in data) || (data.proExpiresAtMillis is int && data.proExpiresAtMillis >= 0));
    }

    function isValidOptionalNightGuardAndNotifyFields(data) {
      return (!('nightGuardEnabled' in data) || data.nightGuardEnabled is bool)
        && (!('nightGuardStartHour' in data) || (data.nightGuardStartHour is int && data.nightGuardStartHour >= 0 && data.nightGuardStartHour <= 23))
        && (!('nightGuardStartMinute' in data) || (data.nightGuardStartMinute is int && data.nightGuardStartMinute >= 0 && data.nightGuardStartMinute <= 59))
        && (!('nightGuardEndHour' in data) || (data.nightGuardEndHour is int && data.nightGuardEndHour >= 0 && data.nightGuardEndHour <= 23))
        && (!('nightGuardEndMinute' in data) || (data.nightGuardEndMinute is int && data.nightGuardEndMinute >= 0 && data.nightGuardEndMinute <= 59))
        && (!('nightGuardCooldownEndMillis' in data) || (data.nightGuardCooldownEndMillis is int && data.nightGuardCooldownEndMillis >= 0))
        && (!('lastChallengeId' in data) || (data.lastChallengeId is string && data.lastChallengeId.size() <= 64))
        && (!('enablePreSpendConfirm' in data) || data.enablePreSpendConfirm is bool)
        && (!('notifyPaymentReminders' in data) || data.notifyPaymentReminders is bool)
        && (!('notifyNightGuardAlert' in data) || data.notifyNightGuardAlert is bool)
        && (!('notifyMorningReview' in data) || data.notifyMorningReview is bool);
    }

    function isValidUserSettings(data, userId) {
      return data.keys().hasAll([
          'userId',
          'dailyLimit',
          'lockdownActive',
          'autoLockdownAt90',
          'stealthMode',
          'themeId',
          'myUpiId',
          'upiGuardTone',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'dailyLimit',
          'lockdownActive',
          'autoLockdownAt90',
          'stealthMode',
          'themeId',
          'myUpiId',
          'upiGuardTone',
          'isPro',
          'proTier',
          'proExpiryMillis',
          'proExpiresAtMillis',
          'nightGuardEnabled',
          'nightGuardStartHour',
          'nightGuardStartMinute',
          'nightGuardEndHour',
          'nightGuardEndMinute',
          'nightGuardCooldownEndMillis',
          'lastChallengeId',
          'enablePreSpendConfirm',
          'notifyPaymentReminders',
          'notifyNightGuardAlert',
          'notifyMorningReview',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string && data.userId == userId
        && data.dailyLimit is int && data.dailyLimit >= 50 && data.dailyLimit <= 500000
        && data.lockdownActive is bool
        && data.autoLockdownAt90 is bool
        && data.stealthMode is bool
        && data.themeId is string && isValidThemeId(data.themeId)
        && data.myUpiId is string && data.myUpiId.size() <= 100
        && data.upiGuardTone is string && isValidGuardTone(data.upiGuardTone)
        && isValidOptionalProFields(data)
        && isValidOptionalNightGuardAndNotifyFields(data)
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidExpense(data, userId) {
      return data.keys().hasAll([
          'userId',
          'title',
          'category',
          'amount',
          'paymentMode',
          'type',
          'note',
          'txEpochMillis',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'title',
          'category',
          'amount',
          'paymentMode',
          'type',
          'note',
          'txEpochMillis',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string && data.userId == userId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.category is string && isValidCategory(data.category)
        && data.amount is int && data.amount > 0 && data.amount <= 10000000
        && data.paymentMode is string && isValidPaymentMode(data.paymentMode)
        && data.type is string && data.type in ['expense', 'income']
        && data.note is string && data.note.size() <= 500
        && data.txEpochMillis is int && data.txEpochMillis > 0
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidKhataFriend(data, userId) {
      return data.keys().hasAll([
          'userId',
          'name',
          'phone',
          'upiId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'name',
          'phone',
          'avatarInitials',
          'upiId',
          'balance',
          'lastDescription',
          'settled',
          'netBalance',
          'lastNote',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string && data.userId == userId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.phone is string && data.phone.size() <= 20
        && data.upiId is string && data.upiId.size() <= 100
        && (!('avatarInitials' in data) || (data.avatarInitials is string && data.avatarInitials.size() <= 8))
        && (!('balance' in data) || (data.balance is int && data.balance >= -10000000 && data.balance <= 10000000))
        && (!('lastDescription' in data) || (data.lastDescription is string && data.lastDescription.size() <= 240))
        && (!('settled' in data) || data.settled is bool)
        && (!('netBalance' in data) || (data.netBalance is int && data.netBalance >= -10000000 && data.netBalance <= 10000000))
        && (!('lastNote' in data) || (data.lastNote is string && data.lastNote.size() <= 240))
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidKhataContact(data, userId) {
      return data.keys().hasAll([
          'userId',
          'contactId',
          'name',
          'phone',
          'avatarInitials',
          'notes',
          'reminderEnabled',
          'createdAtMillis',
          'updatedAtMillis',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'contactId',
          'name',
          'phone',
          'avatarInitials',
          'notes',
          'reminderEnabled',
          'createdAtMillis',
          'updatedAtMillis',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string && data.userId == userId
        && data.contactId is string && data.contactId.size() >= 1 && data.contactId.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.phone is string && data.phone.size() <= 40
        && data.avatarInitials is string && data.avatarInitials.size() <= 8
        && data.notes is string && data.notes.size() <= 400
        && data.reminderEnabled is bool
        && data.createdAtMillis is int && data.createdAtMillis > 0
        && data.updatedAtMillis is int && data.updatedAtMillis > 0
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidKhataEntry(data, userId) {
      return data.keys().hasAll([
          'userId',
          'entryId',
          'contactId',
          'contactName',
          'direction',
          'recordType',
          'parentEntryId',
          'amount',
          'txDateMillis',
          'dueDateMillis',
          'description',
          'category',
          'notes',
          'deleted',
          'archived',
          'edited',
          'previousAmountBeforeEdit',
          'previousDescriptionBeforeEdit',
          'editCount',
          'proofAttachmentUri',
          'proofAttachmentLabel',
          'idempotencyKey',
          'createdAtMillis',
          'updatedAtMillis',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'entryId',
          'contactId',
          'contactName',
          'direction',
          'recordType',
          'parentEntryId',
          'amount',
          'txDateMillis',
          'dueDateMillis',
          'description',
          'category',
          'notes',
          'deleted',
          'archived',
          'edited',
          'previousAmountBeforeEdit',
          'previousDescriptionBeforeEdit',
          'editCount',
          'proofAttachmentUri',
          'proofAttachmentLabel',
          'idempotencyKey',
          'createdAtMillis',
          'updatedAtMillis',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string && data.userId == userId
        && data.entryId is string && data.entryId.size() >= 1 && data.entryId.size() <= 128
        && data.contactId is string && data.contactId.size() >= 1 && data.contactId.size() <= 128
        && data.contactName is string && data.contactName.size() >= 1 && data.contactName.size() <= 80
        && data.direction is string && data.direction in ['LENA_HAI', 'DENA_HAI']
        && data.recordType is string && data.recordType in ['ORIGINAL_ENTRY', 'PARTIAL_PAYMENT', 'FULL_SETTLEMENT']
        && data.parentEntryId is string && data.parentEntryId.size() <= 128
        && data.amount is int && data.amount > 0 && data.amount <= 100000000
        && data.txDateMillis is int && data.txDateMillis > 0
        && data.dueDateMillis is int && data.dueDateMillis >= -1
        && data.description is string && data.description.size() <= 300
        && data.category is string && data.category.size() <= 80
        && data.notes is string && data.notes.size() <= 500
        && data.deleted is bool
        && data.archived is bool
        && data.edited is bool
        && data.previousAmountBeforeEdit is int && data.previousAmountBeforeEdit >= -1
        && data.previousDescriptionBeforeEdit is string && data.previousDescriptionBeforeEdit.size() <= 300
        && data.editCount is int && data.editCount >= 0
        && data.proofAttachmentUri is string && data.proofAttachmentUri.size() <= 1000
        && data.proofAttachmentLabel is string && data.proofAttachmentLabel.size() <= 160
        && data.idempotencyKey is string && data.idempotencyKey.size() <= 180
        && data.createdAtMillis is int && data.createdAtMillis > 0
        && data.updatedAtMillis is int && data.updatedAtMillis > 0
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSavingsGoal(data, userId) {
      return data.keys().hasAll([
          'userId',
          'title',
          'targetAmount',
          'savedAmount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'title',
          'targetAmount',
          'savedAmount',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string && data.userId == userId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.targetAmount is int && data.targetAmount >= 100 && data.targetAmount <= 50000000
        && data.savedAmount is int && data.savedAmount >= 0 && data.savedAmount <= 50000000
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidJarvisMessage(data, userId) {
      return data.keys().hasAll([
          'userId',
          'role',
          'text',
          'mode',
          'language',
          'txEpochMillis',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'role',
          'text',
          'mode',
          'language',
          'txEpochMillis',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string && data.userId == userId
        && data.role is string && data.role in ['user', 'assistant', 'jarvis']
        && data.text is string && data.text.size() > 0 && data.text.size() <= 6000
        && data.mode is string && data.mode in ['roast', 'analyst', 'saver', 'advice']
        && data.language is string && data.language in ['hinglish', 'english', 'hindi']
        && data.txEpochMillis is int && data.txEpochMillis > 0
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPaymentReminder(data, userId) {
      return data.keys().hasAll([
          'userId',
          'title',
          'amount',
          'category',
          'dueEpochMillis',
          'intervalType',
          'isPaid',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'title',
          'amount',
          'category',
          'dueEpochMillis',
          'intervalType',
          'isPaid',
          'note',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string && data.userId == userId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.amount is int && data.amount > 0 && data.amount <= 10000000
        && data.category is string && isValidCategory(data.category)
        && data.dueEpochMillis is int && data.dueEpochMillis > 0
        && data.intervalType is string && data.intervalType in ['same_day', '1_day_before', '3_days_before', 'weekly']
        && data.isPaid is bool
        && data.note is string && data.note.size() <= 300
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidNightGuardEvent(data, userId) {
      return data.keys().hasAll([
          'userId',
          'title',
          'category',
          'amount',
          'outcome',
          'bypassReason',
          'challengeCategory',
          'eventEpochMillis',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'title',
          'category',
          'amount',
          'outcome',
          'bypassReason',
          'challengeCategory',
          'eventEpochMillis',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string && data.userId == userId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.category is string && isValidCategory(data.category)
        && data.amount is int && data.amount > 0 && data.amount <= 10000000
        && data.outcome is string && data.outcome in ['cancelled', 'postponed', 'proceeded', 'essential_bypass']
        && data.bypassReason is string && data.bypassReason.size() <= 120
        && data.challengeCategory is string && data.challengeCategory.size() <= 60
        && data.eventEpochMillis is int && data.eventEpochMillis > 0
        && data.createdAt is timestamp && data.createdAt <= request.time
        && data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserSettings(request.resource.data, userId);
      allow update: if isOwner(userId)
                    && isValidUserSettings(request.resource.data, userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'dailyLimit',
                      'lockdownActive',
                      'autoLockdownAt90',
                      'stealthMode',
                      'themeId',
                      'myUpiId',
                      'upiGuardTone',
                      'isPro',
                      'proTier',
                      'proExpiryMillis',
                      'proExpiresAtMillis',
                      'nightGuardEnabled',
                      'nightGuardStartHour',
                      'nightGuardStartMinute',
                      'nightGuardEndHour',
                      'nightGuardEndMinute',
                      'nightGuardCooldownEndMillis',
                      'lastChallengeId',
                      'enablePreSpendConfirm',
                      'notifyPaymentReminders',
                      'notifyNightGuardAlert',
                      'notifyMorningReview',
                      'updatedAt'
                    ]);
      allow delete: if isOwner(userId);

      match /expenses/{expenseId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidExpense(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidExpense(request.resource.data, userId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'title',
                        'category',
                        'amount',
                        'paymentMode',
                        'type',
                        'note',
                        'txEpochMillis',
                        'updatedAt'
                      ]);
        allow delete: if isOwner(userId);
      }

      match /khata_friends/{friendId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidKhataFriend(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidKhataFriend(request.resource.data, userId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'name',
                        'phone',
                        'avatarInitials',
                        'upiId',
                        'balance',
                        'lastDescription',
                        'settled',
                        'netBalance',
                        'lastNote',
                        'updatedAt'
                      ]);
        allow delete: if isOwner(userId);
      }

      match /khata_contacts/{contactId} {
        allow get: if isOwner(userId) && isValidId(contactId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isValidId(contactId)
                      && isValidKhataContact(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidId(contactId)
                      && isValidKhataContact(request.resource.data, userId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.contactId == resource.data.contactId
                      && request.resource.data.createdAtMillis == resource.data.createdAtMillis
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'name',
                        'phone',
                        'avatarInitials',
                        'notes',
                        'reminderEnabled',
                        'updatedAtMillis',
                        'updatedAt'
                      ]);
        allow delete: if false;
      }

      match /khata_entries/{entryId} {
        allow get: if isOwner(userId) && isValidId(entryId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isValidId(entryId)
                      && isValidKhataEntry(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidId(entryId)
                      && isValidKhataEntry(request.resource.data, userId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.entryId == resource.data.entryId
                      && request.resource.data.contactId == resource.data.contactId
                      && request.resource.data.direction == resource.data.direction
                      && request.resource.data.recordType == resource.data.recordType
                      && request.resource.data.createdAtMillis == resource.data.createdAtMillis
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'contactName',
                        'amount',
                        'dueDateMillis',
                        'description',
                        'category',
                        'notes',
                        'deleted',
                        'archived',
                        'edited',
                        'previousAmountBeforeEdit',
                        'previousDescriptionBeforeEdit',
                        'editCount',
                        'proofAttachmentUri',
                        'proofAttachmentLabel',
                        'updatedAtMillis',
                        'updatedAt'
                      ]);
        allow delete: if false;
      }

      match /savings_goals/{goalId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidSavingsGoal(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidSavingsGoal(request.resource.data, userId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'title',
                        'targetAmount',
                        'savedAmount',
                        'updatedAt'
                      ]);
        allow delete: if isOwner(userId);
      }

      match /jarvis_messages/{messageId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidJarvisMessage(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidJarvisMessage(request.resource.data, userId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'text',
                        'mode',
                        'language',
                        'updatedAt'
                      ]);
        allow delete: if isOwner(userId);
      }

      match /payment_reminders/{reminderId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidPaymentReminder(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidPaymentReminder(request.resource.data, userId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'title',
                        'amount',
                        'category',
                        'dueEpochMillis',
                        'intervalType',
                        'isPaid',
                        'note',
                        'updatedAt'
                      ]);
        allow delete: if isOwner(userId);
      }

      match /night_guard_events/{eventId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidNightGuardEvent(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidNightGuardEvent(request.resource.data, userId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'outcome',
                        'bypassReason',
                        'challengeCategory',
                        'updatedAt'
                      ]);
        allow delete: if isOwner(userId);
      }
    }
  }
}
